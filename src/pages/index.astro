---
import "../styles/global.css";
import { getCollection } from "astro:content";

const cards = await getCollection("cards");
const artworks = await getCollection("artworks");

// Build a set of card slugs that belong to any artwork
const artworkCardSlugs = new Set<string>();
// Map card slug to artwork info
const cardToArtwork = new Map<string, { name: string; id: string; isHead: boolean }>();

artworks.forEach((artwork) => {
  const artworkId = artwork.slug;
  const artworkName = artwork.data.name;

  // Add head artwork
  artworkCardSlugs.add(artwork.data.head_artwork);
  cardToArtwork.set(artwork.data.head_artwork, {
    name: artworkName,
    id: artworkId,
    isHead: true
  });

  // Add grouped artworks
  artwork.data.grouped_artworks.forEach((item) => {
    const slug = typeof item === 'string' ? item : item.card;
    artworkCardSlugs.add(slug);
    cardToArtwork.set(slug, {
      name: artworkName,
      id: artworkId,
      isHead: false
    });
  });
});

// Unique collection names for the dropdown
const collectionNames = [...new Set(cards.map((c) => c.data.collection_name))]
  .filter(Boolean)
  .sort();
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <title>Cubone Field Archive</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Prevent theme FOUC: default to dark unless user explicitly chose light -->
    <script>
      (() => {
        const stored = localStorage.getItem("theme");
        if (stored === "light") {
          document.documentElement.classList.remove("dark");
        } else {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <style>
      :root {
        /* Light theme - warm earthy palette */
        --bone-white: #f5ede4;
        --parchment: #ebe3d5;
        --warm-tan: #c9b79c;
        --terracotta: #d4816b;
        --rust: #a85842;
        --earth-brown: #5d4037;
        --deep-brown: #3e2723;
        --ink: #2c1810;

        /* Dark theme - night at the dig site */
        --night-sky: #1a1410;
        --deep-earth: #2c2420;
        --cave-stone: #3d3530;
        --moonlit-bone: #d4c4b0;
        --ember: #e89b7e;
      }

      body {
        font-family:
          "Manrope",
          -apple-system,
          sans-serif;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Crimson Text", Georgia, serif;
      }

      /* Paper texture overlay */
      .paper-texture {
        position: relative;
      }

      .paper-texture::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(139, 119, 101, 0.03) 2px,
          rgba(139, 119, 101, 0.03) 4px
        );
        pointer-events: none;
        z-index: 1;
      }

      /* Decorative corner elements */
      .corner-accent {
        position: relative;
      }

      .corner-accent::before,
      .corner-accent::after {
        content: "";
        position: absolute;
        width: 20px;
        height: 20px;
        border: 2px solid currentColor;
        opacity: 0.3;
      }

      .corner-accent::before {
        top: -4px;
        left: -4px;
        border-right: none;
        border-bottom: none;
      }

      .corner-accent::after {
        bottom: -4px;
        right: -4px;
        border-left: none;
        border-top: none;
      }

      /* Stamp-like badge effect */
      .stamp-badge {
        position: relative;
        transform: rotate(-2deg);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .stamp-badge:hover {
        transform: rotate(0deg) scale(1.05);
      }

      /* Card reveal animation */
      @keyframes cardReveal {
        from {
          opacity: 0;
          transform: translateY(20px) rotate(-1deg);
        }
        to {
          opacity: 1;
          transform: translateY(0) rotate(0deg);
        }
      }

      .card-item {
        animation: cardReveal 0.5s ease-out backwards;
      }

      .card-item:nth-child(1) {
        animation-delay: 0.05s;
      }
      .card-item:nth-child(2) {
        animation-delay: 0.1s;
      }
      .card-item:nth-child(3) {
        animation-delay: 0.15s;
      }
      .card-item:nth-child(4) {
        animation-delay: 0.2s;
      }
      .card-item:nth-child(5) {
        animation-delay: 0.25s;
      }
      .card-item:nth-child(6) {
        animation-delay: 0.3s;
      }
      .card-item:nth-child(7) {
        animation-delay: 0.35s;
      }
      .card-item:nth-child(8) {
        animation-delay: 0.4s;
      }

      /* Ink stroke header */
      .ink-underline {
        position: relative;
        display: inline-block;
      }

      .ink-underline::after {
        content: "";
        position: absolute;
        bottom: -8px;
        left: -4px;
        right: -4px;
        height: 3px;
        background: linear-gradient(
          90deg,
          transparent 0%,
          var(--terracotta) 5%,
          var(--terracotta) 95%,
          transparent 100%
        );
        opacity: 0.6;
        transform: skewX(-5deg);
      }
    </style>
  </head>

  <body
    class="min-h-screen bg-[var(--bone-white)] text-[var(--ink)] antialiased dark:bg-[var(--night-sky)] dark:text-[var(--moonlit-bone)] paper-texture transition-colors duration-300"
  >
    <!-- Top hero -->
    <header class="relative isolate overflow-hidden">
      <!-- Decorative background -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10"
      >
        <div
          class="absolute inset-0 bg-gradient-to-b from-[var(--parchment)]/40 via-transparent to-transparent dark:from-[var(--deep-earth)]/60"
        >
        </div>
        <!-- Diagonal accent stripes -->
        <div
          class="absolute top-0 right-0 w-1/3 h-64 bg-gradient-to-br from-[var(--terracotta)]/5 to-transparent dark:from-[var(--ember)]/10 transform rotate-12 translate-x-20 -translate-y-20"
        >
        </div>
      </div>

      <div class="max-w-6xl mx-auto px-4 pt-12 pb-8 md:pt-20 md:pb-12">
        <div
          class="flex flex-col md:flex-row md:items-start md:justify-between gap-6"
        >
          <div class="flex-1">
            <div class="inline-block mb-3">
              <span
                class="text-xs tracking-[0.3em] uppercase font-medium text-[var(--rust)] dark:text-[var(--ember)] opacity-80"
                >Field Archive — Est. 1996</span
              >
            </div>
            <h1
              class="text-5xl md:text-7xl font-bold tracking-tight ink-underline mb-4 text-[var(--deep-brown)] dark:text-[var(--moonlit-bone)]"
            >
              Cubone <span
                class="italic font-normal text-[var(--terracotta)] dark:text-[var(--ember)]"
                >Collection</span
              >
            </h1>
            <p
              class="mt-3 text-base md:text-lg leading-relaxed text-[var(--earth-brown)] dark:text-[var(--warm-tan)] max-w-2xl font-light"
            >
              A comprehensive archive of documented Cubone specimens across all
              known expeditions and discoveries.
            </p>
          </div>

          <!-- View and Dark mode toggles -->
          <div class="flex items-center gap-3">
            <!-- View toggle -->
            <button
              id="viewToggle"
              class="corner-accent inline-flex items-center gap-2 border-2 border-[var(--earth-brown)]/30 bg-[var(--parchment)]/60 px-4 py-2.5 text-sm font-medium shadow-md backdrop-blur-sm
                     hover:bg-[var(--parchment)] hover:border-[var(--terracotta)] hover:shadow-lg
                     dark:border-[var(--moonlit-bone)]/20 dark:bg-[var(--deep-earth)]/60 dark:hover:bg-[var(--cave-stone)] dark:hover:border-[var(--ember)]/50
                     transition-all duration-300 text-[var(--earth-brown)] dark:text-[var(--moonlit-bone)]"
              type="button"
              aria-label="Toggle view mode"
            >
              <span class="hidden sm:inline tracking-wide">View</span>
              <span id="viewIcon" class="text-base">⊞</span>
            </button>

            <!-- Dark mode toggle -->
            <button
              id="themeToggle"
              class="corner-accent inline-flex items-center gap-2 border-2 border-[var(--earth-brown)]/30 bg-[var(--parchment)]/60 px-4 py-2.5 text-sm font-medium shadow-md backdrop-blur-sm
                     hover:bg-[var(--parchment)] hover:border-[var(--terracotta)] hover:shadow-lg
                     dark:border-[var(--moonlit-bone)]/20 dark:bg-[var(--deep-earth)]/60 dark:hover:bg-[var(--cave-stone)] dark:hover:border-[var(--ember)]/50
                     transition-all duration-300 text-[var(--earth-brown)] dark:text-[var(--moonlit-bone)]"
              type="button"
              aria-label="Toggle dark mode"
            >
              <span class="hidden sm:inline tracking-wide">Theme</span>
              <span class="block dark:hidden text-base">🌙</span>
              <span class="hidden dark:inline text-base">☀️</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Collection Rules Section -->
      <div class="max-w-6xl mx-auto px-4 pb-10 pt-4">
        <div
          class="relative bg-[var(--parchment)]/40 dark:bg-[var(--deep-earth)]/40 border-l-4 border-[var(--terracotta)] dark:border-[var(--ember)] p-6 md:p-8 rounded-r-lg shadow-sm"
        >
          <h2
            class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-[var(--deep-brown)] dark:text-[var(--moonlit-bone)]"
          >
            Collection Protocol
          </h2>
          <div
            class="space-y-3 text-[var(--earth-brown)] dark:text-[var(--warm-tan)]"
          >
            <p class="flex items-start gap-3">
              <span
                class="text-[var(--terracotta)] dark:text-[var(--ember)] font-bold shrink-0"
                >■</span
              >
              <span
                >Collect all unique artwork variants, holographic patterns, and
                commemorative stamps</span
              >
            </p>
            <p class="flex items-start gap-3">
              <span
                class="text-[var(--terracotta)] dark:text-[var(--ember)] font-bold shrink-0"
                >■</span
              >
              <span
                >Exclude: Minor code variations (<a
                  href="https://docs.google.com/spreadsheets/d/184X4YLZ28T4BkTMHSj2xe0YaPIxlII14/edit?gid=751746442#gid=751746442"
                  class="underline decoration-[var(--terracotta)] dark:decoration-[var(--ember)] decoration-2 hover:text-[var(--terracotta)] dark:hover:text-[var(--ember)] transition-colors font-medium"
                  >EX era reference</a
                >), identical artwork across regional releases</span
              >
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Sticky controls (mobile-collapsible) -->
    <div
      class="sticky top-0 z-20 border-y-2 border-[var(--warm-tan)]/40 bg-[var(--bone-white)]/80 backdrop-blur-md
             dark:border-[var(--cave-stone)]/60 dark:bg-[var(--night-sky)]/85 shadow-md transition-colors duration-300"
    >
      <div class="max-w-6xl mx-auto px-4">
        <!-- Mobile compact bar -->
        <div class="flex items-center justify-between py-3 md:hidden">
          <button
            id="filtersToggle"
            type="button"
            aria-expanded="false"
            class="inline-flex items-center gap-2 border-2 border-[var(--earth-brown)]/30 bg-[var(--parchment)]/60 px-3 py-2 text-sm font-medium shadow-sm backdrop-blur
                   hover:bg-[var(--parchment)] dark:border-[var(--moonlit-bone)]/20 dark:bg-[var(--deep-earth)]/60
                   text-[var(--earth-brown)] dark:text-[var(--moonlit-bone)]"
          >
            <span class="tracking-wide">Filters</span>
            <span aria-hidden="true">▼</span>
          </button>
        </div>

        <form
          id="controls"
          class="hidden md:grid grid-cols-1 md:grid-cols-6 gap-4 py-5 items-end space-y-3 md:space-y-0"
          onsubmit="event.preventDefault()"
        >
          <!-- Filter: Collection -->
          <label class="flex flex-col gap-2">
            <span
              class="text-xs font-semibold tracking-wider uppercase text-[var(--rust)] dark:text-[var(--ember)]"
              >Expedition</span
            >
            <select
              id="collection"
              name="collection"
              class="border-2 border-[var(--warm-tan)]/50 bg-[var(--parchment)]/60 px-3 py-2.5 text-sm
                     outline-none focus:border-[var(--terracotta)] focus:ring-2 focus:ring-[var(--terracotta)]/30
                     dark:border-[var(--cave-stone)] dark:bg-[var(--deep-earth)]/80 dark:focus:border-[var(--ember)]
                     text-[var(--ink)] dark:text-[var(--moonlit-bone)] transition-all duration-200 cursor-pointer"
            >
              <option value="">All expeditions</option>
              {
                collectionNames.map((name) => (
                  <option value={name}>{name}</option>
                ))
              }
            </select>
          </label>

          <!-- Search: Notes/description -->
          <label class="flex flex-col gap-2">
            <span
              class="text-xs font-semibold tracking-wider uppercase text-[var(--rust)] dark:text-[var(--ember)]"
              >Field Notes</span
            >
            <input
              id="q"
              name="q"
              type="search"
              placeholder="holo, stamp, edition..."
              class="border-2 border-[var(--warm-tan)]/50 bg-[var(--parchment)]/60 px-3 py-2.5 text-sm
                     outline-none focus:border-[var(--terracotta)] focus:ring-2 focus:ring-[var(--terracotta)]/30
                     dark:border-[var(--cave-stone)] dark:bg-[var(--deep-earth)]/80 dark:focus:border-[var(--ember)]
                     text-[var(--ink)] dark:text-[var(--moonlit-bone)] placeholder:text-[var(--earth-brown)]/50
                     dark:placeholder:text-[var(--warm-tan)]/40 transition-all duration-200"
            />
          </label>

          <!-- Sort: Release date -->
          <label class="flex flex-col gap-2">
            <span
              class="text-xs font-semibold tracking-wider uppercase text-[var(--rust)] dark:text-[var(--ember)]"
              >Chronology</span
            >
            <select
              id="sort"
              name="sort"
              class="border-2 border-[var(--warm-tan)]/50 bg-[var(--parchment)]/60 px-3 py-2.5 text-sm
                     outline-none focus:border-[var(--terracotta)] focus:ring-2 focus:ring-[var(--terracotta)]/30
                     dark:border-[var(--cave-stone)] dark:bg-[var(--deep-earth)]/80 dark:focus:border-[var(--ember)]
                     text-[var(--ink)] dark:text-[var(--moonlit-bone)] transition-all duration-200 cursor-pointer"
            >
              <option value="desc">Recent → Ancient</option>
              <option value="asc">Ancient → Recent</option>
            </select>
          </label>

          <!-- Toggles row -->
          <div class="flex flex-row gap-4">
            <!-- Toggle: Missing only -->
            <label class="flex flex-col gap-2 flex-1">
              <span
                class="text-xs font-semibold tracking-wider uppercase text-[var(--rust)] dark:text-[var(--ember)]"
              >
                Missing
              </span>
              <label
                class="relative inline-flex items-center cursor-pointer align-middle max-h-full"
              >
                <input
                  type="checkbox"
                  id="missingToggle"
                  class="sr-only peer"
                />
                <div
                  class="w-11 h-6 bg-[var(--warm-tan)]/50 border-2 border-[var(--warm-tan)] rounded-full peer
                         peer-checked:bg-[var(--terracotta)] peer-checked:border-[var(--terracotta)]
                         peer-focus:ring-2 peer-focus:ring-[var(--terracotta)]/30
                         dark:bg-[var(--cave-stone)] dark:border-[var(--cave-stone)]
                         dark:peer-checked:bg-[var(--ember)] dark:peer-checked:border-[var(--ember)]
                         transition-all duration-300"
                >
                </div>
                <span
                  class="absolute left-[2px] top-[2px] h-5 w-5 rounded-full bg-[var(--bone-white)]
                         shadow-sm transition-transform duration-300 peer-checked:translate-x-5
                         dark:bg-[var(--moonlit-bone)]"
                ></span>
              </label>
            </label>

            <!-- Toggle: Show extras -->
            <label class="flex flex-col gap-2 flex-1">
              <span
                class="text-xs font-semibold tracking-wider uppercase text-[var(--rust)] dark:text-[var(--ember)]"
              >
                Extra
              </span>
              <label
                class="relative inline-flex items-center cursor-pointer align-middle max-h-full"
              >
                <input type="checkbox" id="extraToggle" class="sr-only peer" />
                <div
                  class="w-11 h-6 bg-[var(--warm-tan)]/50 border-2 border-[var(--warm-tan)] rounded-full peer
                         peer-checked:bg-[var(--terracotta)] peer-checked:border-[var(--terracotta)]
                         peer-focus:ring-2 peer-focus:ring-[var(--terracotta)]/30
                         dark:bg-[var(--cave-stone)] dark:border-[var(--cave-stone)]
                         dark:peer-checked:bg-[var(--ember)] dark:peer-checked:border-[var(--ember)]
                         transition-all duration-300"
                >
                </div>
                <span
                  class="absolute left-[2px] top-[2px] h-5 w-5 rounded-full bg-[var(--bone-white)]
                         shadow-sm transition-transform duration-300 peer-checked:translate-x-5
                         dark:bg-[var(--moonlit-bone)]"
                ></span>
              </label>
            </label>

            <!-- Toggle: Artworks -->
            <label class="flex flex-col gap-2 flex-1">
              <span
                class="text-xs font-semibold tracking-wider uppercase text-[var(--rust)] dark:text-[var(--ember)]"
              >
                Artworks
              </span>
              <label
                class="relative inline-flex items-center cursor-pointer align-middle max-h-full"
              >
                <input type="checkbox" id="artworkToggle" class="sr-only peer" />
                <div
                  class="w-11 h-6 bg-[var(--warm-tan)]/50 border-2 border-[var(--warm-tan)] rounded-full peer
                         peer-checked:bg-[var(--terracotta)] peer-checked:border-[var(--terracotta)]
                         peer-focus:ring-2 peer-focus:ring-[var(--terracotta)]/30
                         dark:bg-[var(--cave-stone)] dark:border-[var(--cave-stone)]
                         dark:peer-checked:bg-[var(--ember)] dark:peer-checked:border-[var(--ember)]
                         transition-all duration-300"
                >
                </div>
                <span
                  class="absolute left-[2px] top-[2px] h-5 w-5 rounded-full bg-[var(--bone-white)]
                         shadow-sm transition-transform duration-300 peer-checked:translate-x-5
                         dark:bg-[var(--moonlit-bone)]"
                ></span>
              </label>
            </label>
          </div>
        </form>
      </div>
    </div>

    <!-- Content -->
    <main class="max-w-6xl mx-auto px-4 py-6 space-y-4">
      <!-- Results counter -->
      <div
        id="resultCount"
        class="pb-2 text-right text-sm font-medium tracking-wide text-[var(--earth-brown)] dark:text-[var(--warm-tan)]"
      >
        <span class="font-mono">Showing 0 specimens</span>
      </div>

      <!-- Cards Container -->
      <div
        id="cardsContainer"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5"
      >
        {
          cards.map(({ slug, data }) => {
            const {
              name,
              number,
              release_date,
              collection_name,
              image,
              first_edition,
              holographic,
              missing,
              extra,
              notes,
            } = data;
            const searchText = [name, collection_name, number, notes]
              .join(" ")
              .toLowerCase();
            const ts = release_date.getTime();
            const artworkInfo = cardToArtwork.get(slug);
            return (
              <article
                class="card-item group border-2 border-[var(--warm-tan)]/40 bg-[var(--parchment)]/30 shadow-md transition-all duration-300
                       hover:shadow-xl hover:border-[var(--terracotta)] hover:-translate-y-1
                       dark:border-[var(--cave-stone)]/60 dark:bg-[var(--deep-earth)]/40 dark:hover:border-[var(--ember)]
                       overflow-hidden backdrop-blur-sm"
                data-coll={collection_name}
                data-date={release_date}
                data-search={searchText}
                data-ts={ts}
                data-missing={missing ? "1" : "0"}
                data-extra={extra ? "1" : "0"}
                data-artwork={artworkCardSlugs.has(slug) ? "1" : "0"}
                data-artwork-id={artworkInfo?.id || ""}
                data-artwork-name={artworkInfo?.name || ""}
                data-is-head={artworkInfo?.isHead ? "1" : "0"}
              >
                {/* Grid content - shown in grid view */}
                <div class="grid-content">
                  {/* Image with badges */}
                  <div class="relative flex items-center justify-center bg-[var(--bone-white)]/60 p-4 dark:bg-[var(--night-sky)]/40 aspect-[3/4] border-b-2 border-[var(--warm-tan)]/30 dark:border-[var(--cave-stone)]/40">
                    {image ? (
                      <button
                        type="button"
                        class="block w-full h-full"
                        data-zoom-src={image}
                        data-zoom-alt={name}
                        aria-label={`Zoom image of ${name}`}
                      >
                        <img
                          src={image}
                          alt={name}
                          loading="lazy"
                          class="w-full h-full object-contain cursor-zoom-in transition-transform duration-500 hover:scale-[1.08] drop-shadow-lg"
                        />
                      </button>
                    ) : (
                      <div class="flex h-full w-full items-center justify-center text-[var(--warm-tan)] dark:text-[var(--cave-stone)] text-sm font-medium">
                        Undocumented
                      </div>
                    )}
                    {/* Status badges overlay */}
                    <div class="absolute top-3 right-3 flex flex-col gap-2">
                      {missing && (
                        <span
                          class="stamp-badge inline-flex items-center justify-center rounded-full border border-[var(--rust)]/40 bg-red-50/50 backdrop-blur-sm w-9 h-9 text-base shadow-sm dark:bg-red-900/30 dark:border-red-400/30"
                          title="Missing"
                        >
                          🔎
                        </span>
                      )}
                      {extra && (
                        <span
                          class="stamp-badge inline-flex items-center justify-center rounded-full border border-purple-600/40 bg-purple-50/50 backdrop-blur-sm w-9 h-9 text-base shadow-sm dark:bg-purple-900/30 dark:border-purple-400/30"
                          title="Extra"
                        >
                          🧩
                        </span>
                      )}
                      {holographic && (
                        <span
                          class="stamp-badge inline-flex items-center justify-center rounded-full border border-yellow-600/40 bg-yellow-50/50 backdrop-blur-sm w-9 h-9 text-base shadow-sm dark:bg-yellow-900/30 dark:border-yellow-400/30"
                          title="Holographic"
                        >
                          ✨
                        </span>
                      )}
                      {first_edition && (
                        <span
                          class="stamp-badge inline-flex items-center justify-center rounded-full border border-blue-600/40 bg-blue-50/50 backdrop-blur-sm w-9 h-9 text-base shadow-sm dark:bg-blue-900/30 dark:border-blue-400/30"
                          title="First Edition"
                        >
                          🥇
                        </span>
                      )}
                    </div>
                  </div>

                  {/* Card info */}
                  <div class="p-4 space-y-2 bg-gradient-to-b from-transparent to-[var(--parchment)]/20 dark:to-[var(--deep-earth)]/20">
                    <div class="flex items-start justify-between gap-2">
                      <h2
                        class="text-base font-bold tracking-tight flex-1 min-w-0 truncate text-[var(--deep-brown)] dark:text-[var(--moonlit-bone)]"
                        title={name}
                      >
                        {name}
                      </h2>
                      <span class="text-xs font-mono font-semibold text-[var(--rust)] dark:text-[var(--ember)] shrink-0">
                        #{number}
                      </span>
                    </div>
                    <p class="text-xs text-[var(--earth-brown)] dark:text-[var(--warm-tan)]">
                      {collection_name || (
                        <span class="italic opacity-60">Unclassified</span>
                      )}
                      <span class="mx-1.5 opacity-50">•</span>
                      {release_date ? (
                        new Date(release_date).toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "short",
                        })
                      ) : (
                        <span class="italic opacity-60">Date unknown</span>
                      )}
                    </p>
                    {notes && (
                      <p
                        class="text-sm leading-relaxed text-[var(--earth-brown)] dark:text-[var(--warm-tan)] line-clamp-2 italic"
                        title={notes}
                      >
                        {notes}
                      </p>
                    )}
                  </div>
                </div>

                {/* List content - shown in list view */}
                <div class="list-content hidden">
                  <div class="flex flex-col md:flex-row items-stretch">
                    {/* Media */}
                    <div class="flex w-full md:w-[28rem] items-center justify-center bg-[var(--bone-white)]/60 p-6 dark:bg-[var(--night-sky)]/40 border-r-2 border-[var(--warm-tan)]/30 dark:border-[var(--cave-stone)]/40">
                      {image ? (
                        <button
                          type="button"
                          class="block w-full"
                          data-zoom-src={image}
                          data-zoom-alt={name}
                          aria-label={`Zoom image of ${name}`}
                        >
                          <img
                            src={image}
                            alt={name}
                            loading="lazy"
                            class="w-full max-w-full max-h-[22rem] object-contain cursor-zoom-in transition-transform duration-500 hover:scale-[1.03] drop-shadow-xl"
                          />
                        </button>
                      ) : (
                        <div class="flex h-60 w-full items-center justify-center text-[var(--warm-tan)] dark:text-[var(--cave-stone)] font-medium">
                          Undocumented specimen
                        </div>
                      )}
                    </div>

                    {/* Meta */}
                    <div class="flex flex-1 flex-col justify-between p-5 md:p-7 bg-gradient-to-br from-transparent to-[var(--parchment)]/20 dark:to-[var(--deep-earth)]/20">
                      <div class="space-y-4">
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                          <div class="flex items-start gap-3">
                            <h2 class="text-2xl font-bold tracking-tight text-[var(--deep-brown)] dark:text-[var(--moonlit-bone)]">
                              {name}
                            </h2>
                            <span class="text-sm font-mono font-semibold text-[var(--rust)] dark:text-[var(--ember)] shrink-0 mt-1">
                              #{number}
                            </span>
                          </div>
                          <div class="flex flex-wrap gap-2 justify-start sm:justify-end">
                            {first_edition && (
                              <span
                                class="stamp-badge inline-flex items-center gap-1.5 rounded-full border border-blue-600/40 bg-blue-50/60 px-3 py-1.5 text-xs font-semibold text-blue-800
                               dark:border-blue-400/30 dark:bg-blue-950/40 dark:text-blue-300/90 shadow-sm"
                              >
                                🥇 First Edition
                              </span>
                            )}
                            {holographic && (
                              <span
                                class="stamp-badge inline-flex items-center gap-1.5 rounded-full border border-yellow-600/40 bg-yellow-50/60 px-3 py-1.5 text-xs font-semibold text-yellow-800
                               dark:border-yellow-400/30 dark:bg-yellow-950/40 dark:text-yellow-300/90 shadow-sm"
                              >
                                ✨ Holographic
                              </span>
                            )}
                            {missing && (
                              <span
                                class="stamp-badge inline-flex items-center gap-1.5 rounded-full border border-[var(--rust)]/40 bg-red-50/60 px-3 py-1.5 text-xs font-semibold text-red-800
                               dark:border-red-400/30 dark:bg-red-950/40 dark:text-red-300/90 shadow-sm"
                              >
                                🔎 Sought
                              </span>
                            )}
                            {extra && (
                              <span
                                class="stamp-badge inline-flex items-center gap-1.5 rounded-full border border-purple-600/40 bg-purple-50/60 px-3 py-1.5 text-xs font-semibold text-purple-800
                               dark:border-purple-400/30 dark:bg-purple-950/40 dark:text-purple-300/90 shadow-sm"
                              >
                                🧩 Extra
                              </span>
                            )}
                          </div>
                        </div>

                        <p class="text-sm font-medium text-[var(--earth-brown)] dark:text-[var(--warm-tan)]">
                          {collection_name || (
                            <span class="italic text-[var(--warm-tan)] dark:text-[var(--cave-stone)]">
                              Unclassified
                            </span>
                          )}
                          <span class="mx-2 text-[var(--warm-tan)] dark:text-[var(--cave-stone)]">
                            •
                          </span>
                          {data.release_date ? (
                            new Date(data.release_date).toLocaleDateString(
                              "en-US",
                              {
                                year: "numeric",
                                month: "short",
                              },
                            )
                          ) : (
                            <span class="italic text-[var(--warm-tan)] dark:text-[var(--cave-stone)]">
                              Date unknown
                            </span>
                          )}
                        </p>

                        {notes && (
                          <div class="border-l-3 border-[var(--terracotta)] dark:border-[var(--ember)] pl-4 py-1">
                            <p class="text-base leading-relaxed text-[var(--earth-brown)] dark:text-[var(--warm-tan)] italic">
                              {notes.length > 220
                                ? notes.slice(0, 220) + "…"
                                : notes}
                            </p>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      <!-- Empty state -->
      <div
        id="empty"
        class="hidden border-2 border-dashed border-[var(--warm-tan)] bg-[var(--parchment)]/40 p-12 text-center
               dark:border-[var(--cave-stone)] dark:bg-[var(--deep-earth)]/40"
      >
        <div class="text-4xl mb-3">🦴</div>
        <p
          class="text-lg font-bold text-[var(--deep-brown)] dark:text-[var(--moonlit-bone)] mb-2"
        >
          No specimens found
        </p>
        <p
          class="text-sm text-[var(--earth-brown)] dark:text-[var(--warm-tan)] max-w-md mx-auto"
        >
          The archive contains no records matching your search criteria. Try
          adjusting your expedition, field notes, or chronology filters.
        </p>
      </div>
    </main>

    <!-- Image Modal -->
    <div
      id="imgModal"
      class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-[var(--night-sky)]/95 backdrop-blur-md p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="imgModalLabel"
    >
      <div
        class="max-w-5xl w-full flex flex-col items-center justify-center"
        role="document"
      >
        <figure
          class="relative bg-[var(--deep-earth)] p-4 shadow-2xl border-4 border-[var(--cave-stone)]/60 flex flex-col items-center"
        >
          <!-- Close button (top-right, near image) -->
          <button
            id="imgModalClose"
            type="button"
            aria-label="Close image"
            class="absolute -top-3 -right-3 z-10 border-2 border-[var(--ember)] bg-[var(--deep-earth)] px-4 py-3 text-sm font-bold
               shadow-lg hover:bg-[var(--cave-stone)] hover:scale-110 focus:outline-none focus:ring-2 focus:ring-[var(--ember)]
               text-[var(--moonlit-bone)] transition-all duration-200"
          >
            ✕
          </button>

          <img
            id="imgModalImg"
            alt=""
            class="mx-auto max-h-[80vh] w-auto object-contain drop-shadow-2xl"
            decoding="async"
          />
          <figcaption
            id="imgModalLabel"
            class="mt-4 text-center text-base font-semibold text-[var(--moonlit-bone)] tracking-wide"
          >
          </figcaption>
        </figure>
      </div>
    </div>

    <!-- Scripts -->
    <script type="module">
      const $ = (s) => document.querySelector(s);
      const $$ = (s) => Array.from(document.querySelectorAll(s));
      const cardsContainer = $("#cardsContainer");
      const empty = $("#empty");
      const collection = $("#collection");
      const missingToggle = $("#missingToggle");
      const extraToggle = $("#extraToggle");
      const artworkToggle = $("#artworkToggle");
      const q = $("#q");
      const sort = $("#sort");
      const resultCount = $("#resultCount");
      const filtersToggle = $("#filtersToggle");
      const controlsForm = $("#controls");
      const viewToggle = $("#viewToggle");
      const viewIcon = $("#viewIcon");

      let showMissingOnly = false;
      let showExtra = false; // off = hide extras
      let showArtworkOnly = false;
      let currentView = localStorage.getItem("cardView") || "grid";

      // Store all original card items once at initialization
      const allCardItems = $$(".card-item");

      // Initialize view
      function setView(view) {
        currentView = view;
        localStorage.setItem("cardView", view);

        const gridContents = $$(".grid-content");
        const listContents = $$(".list-content");

        if (view === "grid") {
          // Show grid layout
          cardsContainer.classList.add(
            "grid",
            "grid-cols-1",
            "sm:grid-cols-2",
            "lg:grid-cols-3",
            "xl:grid-cols-4",
            "gap-4",
          );
          cardsContainer.classList.remove("space-y-4");

          // Show grid content, hide list content
          gridContents.forEach((el) => el.classList.remove("hidden"));
          listContents.forEach((el) => el.classList.add("hidden"));

          viewIcon.textContent = "☰"; // Show list icon when in grid view
        } else {
          // Show list layout
          cardsContainer.classList.remove(
            "grid",
            "grid-cols-1",
            "sm:grid-cols-2",
            "lg:grid-cols-3",
            "xl:grid-cols-4",
            "gap-4",
          );
          cardsContainer.classList.add("space-y-4");

          // Show list content, hide grid content
          gridContents.forEach((el) => el.classList.add("hidden"));
          listContents.forEach((el) => el.classList.remove("hidden"));

          viewIcon.textContent = "⊞"; // Show grid icon when in list view
        }

        apply();
      }

      function apply() {
        const coll = collection.value.trim().toLowerCase();
        const query = q.value.trim().toLowerCase();
        const items = allCardItems;
        let visible = [];

        for (const el of items) {
          const elColl = (el.getAttribute("data-coll") || "").toLowerCase();
          const elMissing = el.getAttribute("data-missing") || "0";
          const elExtra = el.getAttribute("data-extra") || "0";
          const elArtwork = el.getAttribute("data-artwork") || "0";
          const blob = el.getAttribute("data-search") || "";

          const passColl = !coll || elColl === coll;
          const passQuery = !query || blob.includes(query);
          const passMissing = !showMissingOnly || elMissing === "1";
          // Hide extras unless toggle is on
          const passExtra = showExtra ? true : elExtra !== "1";
          // Show only artwork cards when toggle is on
          const passArtwork = !showArtworkOnly || elArtwork === "1";

          if (passColl && passQuery && passMissing && passExtra && passArtwork) {
            el.classList.remove("hidden");
            visible.push(el);
          } else {
            el.classList.add("hidden");
          }
        }

        // Clear existing artwork headers
        $$(".artwork-header").forEach(el => el.remove());

        if (showArtworkOnly && visible.length > 0) {
          // Group by artwork
          const artworkGroups = new Map();

          visible.forEach(el => {
            const artworkId = el.getAttribute("data-artwork-id") || "";
            const artworkName = el.getAttribute("data-artwork-name") || "";
            const isHead = el.getAttribute("data-is-head") === "1";

            if (!artworkGroups.has(artworkId)) {
              artworkGroups.set(artworkId, {
                name: artworkName,
                head: null,
                cards: []
              });
            }

            if (isHead) {
              artworkGroups.get(artworkId).head = el;
            } else {
              artworkGroups.get(artworkId).cards.push(el);
            }
          });

          // Clear container
          cardsContainer.innerHTML = "";

          // Render each artwork group
          artworkGroups.forEach((group, artworkId) => {
            // Create artwork header
            const header = document.createElement("div");
            header.className = "artwork-header col-span-full mb-4 mt-8 first:mt-0";
            header.innerHTML = `
              <div class="flex items-center gap-4">
                <div class="flex-1 h-px bg-gradient-to-r from-transparent via-[var(--terracotta)] to-transparent dark:via-[var(--ember)] opacity-50"></div>
                <h2 class="text-xl font-bold tracking-tight text-[var(--deep-brown)] dark:text-[var(--moonlit-bone)] px-4">
                  🎨 ${group.name}
                </h2>
                <div class="flex-1 h-px bg-gradient-to-r from-[var(--terracotta)] via-[var(--terracotta)] to-transparent dark:from-[var(--ember)] dark:via-[var(--ember)] opacity-50"></div>
              </div>
            `;
            cardsContainer.appendChild(header);

            // Add head artwork first if it exists
            if (group.head) {
              cardsContainer.appendChild(group.head);
            }

            // Add other cards
            group.cards.forEach(card => cardsContainer.appendChild(card));
          });
        } else {
          // Normal sort and append
          visible.sort((a, b) => {
            const ta = Number(a.getAttribute("data-ts")) || 0;
            const tb = Number(b.getAttribute("data-ts")) || 0;
            const rank = (t, dir) =>
              t === 0
                ? dir === "asc"
                  ? Number.POSITIVE_INFINITY
                  : Number.NEGATIVE_INFINITY
                : t;
            const dir = sort.value;
            return dir === "asc"
              ? rank(ta, dir) - rank(tb, dir)
              : rank(tb, dir) - rank(ta, dir);
          });

          // Clear container and re-append in sorted order
          cardsContainer.innerHTML = "";
          visible.forEach((el) => cardsContainer.appendChild(el));
        }

        empty.classList.toggle("hidden", visible.length > 0);

        // Update counter
        resultCount.innerHTML = `<span class="font-mono">Showing ${visible.length} specimen${
          visible.length === 1 ? "" : "s"
        }</span>`;
      }

      // View toggle
      viewToggle?.addEventListener("click", () => {
        setView(currentView === "grid" ? "list" : "grid");
      });

      // Theme toggle
      const btn = document.getElementById("themeToggle");
      btn?.addEventListener("click", () => {
        const html = document.documentElement;
        const next = html.classList.toggle("dark") ? "dark" : "light";
        localStorage.setItem("theme", next);
      });

      // Filters logic
      collection.addEventListener("change", apply);
      missingToggle.addEventListener("change", () => {
        showMissingOnly = missingToggle.checked;
        apply();
      });
      extraToggle.addEventListener("change", () => {
        showExtra = extraToggle.checked;
        apply();
      });
      artworkToggle.addEventListener("change", () => {
        showArtworkOnly = artworkToggle.checked;
        apply();
      });
      q.addEventListener("input", apply);
      sort.addEventListener("change", apply);

      // Initialize view and apply filters
      setView(currentView);

      // Mobile: toggle filters panel
      filtersToggle?.addEventListener("click", () => {
        const wasHidden = controlsForm.classList.contains("hidden");
        if (wasHidden) {
          controlsForm.classList.remove("hidden");
          controlsForm.classList.add("block"); // ensure visible on mobile
        } else {
          controlsForm.classList.add("hidden");
          controlsForm.classList.remove("block");
        }
        const open = String(wasHidden);
        filtersToggle.setAttribute("aria-expanded", open);
        const caret = filtersToggle.querySelector('span[aria-hidden="true"]');
        if (caret) caret.textContent = wasHidden ? "▲" : "▼";
      });

      // Keep form visible on desktop, collapsed on mobile when closed
      window.addEventListener("resize", () => {
        if (window.matchMedia("(min-width: 768px)").matches) {
          controlsForm.classList.remove("hidden", "block");
        } else if (filtersToggle?.getAttribute("aria-expanded") !== "true") {
          controlsForm.classList.add("hidden");
          controlsForm.classList.remove("block");
        }
      });
      // ---------- IMAGE MODAL ----------
      const modal = document.getElementById("imgModal");
      const modalImg = document.getElementById("imgModalImg");
      const modalLabel = document.getElementById("imgModalLabel");
      const modalClose = document.getElementById("imgModalClose");
      let lastFocused = null;

      // Open modal
      function openImgModal(src, alt, trigger) {
        lastFocused = trigger || document.activeElement;

        modalImg.src = src;
        modalImg.alt = alt || "";
        modalLabel.textContent = alt || "";

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.classList.add("overflow-hidden");
        modalClose.focus();
      }

      // Close modal
      function closeImgModal() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.classList.remove("overflow-hidden");
        modalImg.removeAttribute("src");
        modalLabel.textContent = "";
        if (lastFocused) lastFocused.focus();
      }

      // Wire buttons
      $$("button[data-zoom-src]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const src = btn.getAttribute("data-zoom-src");
          const alt = btn.getAttribute("data-zoom-alt") || "";
          if (src) openImgModal(src, alt, btn);
        });
      });

      // Close actions
      modalClose.addEventListener("click", closeImgModal);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeImgModal(); // click backdrop
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden"))
          closeImgModal();
      });
    </script>
  </body>
</html>
